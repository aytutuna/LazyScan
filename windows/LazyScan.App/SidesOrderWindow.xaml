<Window x:Class="LazyScan.App.SidesOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyScan.App"
        xmlns:loc="clr-namespace:LazyScan.App"
        xmlns:core="clr-namespace:LazyScan.Core;assembly=LazyScan.Core"
        Title="{x:Static core:SidesSaveText.Title}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static core:SidesSaveText.CombineLabel}" IsDefault="True" MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}" Click="Combine_Click" />
                <Button Content="{x:Static core:SidesSaveText.FrontsOnlyLabel}" MinWidth="96" Margin="8,0,0,0" Click="FrontsOnly_Click" />
                <Button Content="{loc:T Cancel}" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="{x:Static core:SidesSaveText.Title}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static core:SidesSaveText.Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
