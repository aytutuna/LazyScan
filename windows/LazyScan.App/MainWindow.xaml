<Window x:Class="LazyScan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LazyScan.App"
        xmlns:local="clr-namespace:LazyScan.App"
        xmlns:core="clr-namespace:LazyScan.Core;assembly=LazyScan.Core"
        Title="Lazy Scan"
        Width="1200" Height="800" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Static local:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Margin" Value="{StaticResource SectionSpacing}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SliderLabelText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The Save button's label: its glyph (a lock for a protected PDF), the label and a badge with
             the number of pages (the button's Tag; no badge while it is null). -->
        <DataTemplate x:Key="SaveLabelTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Margin="0,0,8,0"
                           Text="{Binding Path=(local:Icon.Glyph), RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                <Border x:Name="Badge" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="20" Height="18" Padding="6,0,6,1"
                        CornerRadius="9" VerticalAlignment="Center"
                        Background="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                </Border>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="False">
                    <Setter TargetName="Badge" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="PageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The InfoBars: outside MainContent, so they stay usable while the photo review is open. -->
        <StackPanel Grid.Row="0">
            <!-- Errors. -->
            <Border x:Name="InfoBar" Style="{StaticResource InfoBarStyle}" Visibility="Collapsed">
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <TextBlock DockPanel.Dock="Left" x:Name="InfoBarGlyph" Style="{StaticResource GlyphText}" Text="&#xEB90;" Margin="0,0,12,0"
                               VerticalAlignment="Top" Padding="0,2,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="{loc:T Dismiss}" AutomationProperties.Name="{loc:T Dismiss}" VerticalAlignment="Top"
                            KeyboardNavigation.TabIndex="2" Click="InfoBarClose_Click" />
                    <!-- Shown when the error is a copy that did not print: its pages are still held. -->
                    <StackPanel DockPanel.Dock="Right" x:Name="InfoBarCopyActions" VerticalAlignment="Top" Margin="8,0,4,0"
                                Visibility="Collapsed">
                        <Button Style="{StaticResource SubtleButtonStyle}" local:Icon.Glyph="&#xE749;"
                                Content="{loc:T Print again}"
                                ToolTip="{loc:T Print the copy again on the same printer}"
                                AutomationProperties.HelpText="{loc:T Prints the copy again on the same printer}"
                                KeyboardNavigation.TabIndex="1" Click="PrintAgain_Click" />
                        <Button Style="{StaticResource SubtleButtonStyle}" local:Icon.Glyph="&#xE7F7;"
                                Content="{loc:T Choose another printer}"
                                ToolTip="{loc:T Pick a printer for the copy}"
                                AutomationProperties.HelpText="{loc:T Opens the printer list in the copy options}"
                                KeyboardNavigation.TabIndex="1" Click="ChooseAnotherPrinter_Click" />
                    </StackPanel>
                    <!-- Shown when the error is a scanner that would not connect or scan. -->
                    <Button DockPanel.Dock="Right" x:Name="InfoBarTroubleshootButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE9CE;" Content="{loc:T Troubleshoot}" VerticalAlignment="Top" Margin="8,0,4,0"
                            Visibility="Collapsed"
                            ToolTip="{loc:T Find out what\'s stopping the scanner}"
                            AutomationProperties.HelpText="{loc:T Opens the troubleshooter: checks what stops scanners from appearing or connecting}"
                            Click="Troubleshoot_Click" />
                    <TextBlock x:Name="InfoBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"><Run
                            x:Name="InfoBarTitle" Text="{x:Static core:ScannerProblems.GenericTitle}" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="InfoBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- After a save: what was saved, with what can be done with it. Hidden by its close
                 button or when the next scan starts. The buttons fold to their glyphs in narrow
                 windows (SavedBar_SizeChanged); their names stay in tooltips and for screen readers. -->
            <Border x:Name="SavedBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed"
                    SizeChanged="SavedBar_SizeChanged">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE930;" Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="{loc:T Dismiss}" AutomationProperties.Name="{loc:T Dismiss}" VerticalAlignment="Center"
                            Margin="4,0,0,0" Click="SavedBarClose_Click" />
                    <StackPanel DockPanel.Dock="Right" x:Name="SavedBarButtons" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="SavedUndoButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE7A7;" Content="{loc:T Undo}" Visibility="Collapsed"
                                AutomationProperties.AcceleratorKey="Ctrl+Z"
                                AutomationProperties.HelpText="{loc:T Puts the pages back\, deleting the saved files or restoring the PDF they were added to. Files already shared or sent stay where they went.}"
                                Click="Undo_Click" />
                        <Button x:Name="SavedOpenButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE8A7;" Content="{loc:T Open}" Tag="Open"
                                ToolTip="{loc:T Open with the default app}" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedRevealButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE838;" Content="{loc:T Show in folder}" Tag="Reveal"
                                ToolTip="{loc:T Show in File Explorer}" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedShareButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE72D;" Content="{loc:T Share}" Tag="Share"
                                ToolTip="{loc:T Send with Mail\, Outlook\, nearby sharing or another app}" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedMoreButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE712;"
                                Width="32" Height="32"
                                ToolTip="{loc:T More}" AutomationProperties.Name="{loc:T More actions}"
                                AutomationProperties.HelpText="{loc:T Opens a menu: copy\, open with\, email and the other actions}"
                                Click="SavedBarMore_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SavedBarText" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"><Run
                            Text="{loc:T Saved}" FontWeight="SemiBold" /><Run Text=" · " /><Run x:Name="SavedBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- A paired phone sent a document: its pages were added to the queue (or wait for it).
                 Hidden by its close button; the next document replaces the text. -->
            <Border x:Name="PhoneBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE8EA;" Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="{loc:T Dismiss}" AutomationProperties.Name="{loc:T Dismiss}" VerticalAlignment="Center"
                            Margin="4,0,0,0" Click="PhoneBarClose_Click" />
                    <TextBlock x:Name="PhoneBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Padding="0,4"
                               AutomationProperties.LiveSetting="Polite"><Run
                            Text="{loc:T From your phone}" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="PhoneBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- A .lsdoc opened by hand (dropped, picked, or opened from File Explorer): its pages wait
                 here until they are added or opened as a new document. Shown while the view model offers it. -->
            <Border x:Name="PackageBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE8A5;" Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="{loc:T Dismiss}" AutomationProperties.Name="{loc:T Dismiss}" VerticalAlignment="Center"
                            Margin="4,0,0,0" Click="PackageBarClose_Click" />
                    <StackPanel DockPanel.Dock="Right" x:Name="PackageBarButtons" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="PackageAddButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE710;" Content="{x:Static local:PackageText.AddToPages}"
                                ToolTipService.ShowOnDisabled="True" Click="PackageAdd_Click" />
                        <Button x:Name="PackageOpenButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE8E5;" Content="{x:Static local:PackageText.OpenAsNew}"
                                ToolTipService.ShowOnDisabled="True" Click="PackageOpen_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PackageBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Padding="0,4"
                               AutomationProperties.LiveSetting="Polite"><Run x:Name="PackageBarMessage" /></TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" x:Name="MainContent">
            <!-- Sidebar: scanners + presets, directly on the window backdrop. Below a width
                 threshold it folds to an icon rail (see UpdatePane); names stay in tooltips. -->
            <Grid DockPanel.Dock="Left" x:Name="Sidebar" Width="216">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Left" x:Name="PaneToggleButton" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE700;" Width="40" Height="36" Margin="4,4,0,4" Visibility="Collapsed"
                            ToolTip="{loc:T Show scanner and preset names}"
                            AutomationProperties.Name="{loc:T Show scanner and preset names}"
                            Click="PaneToggle_Click" />
                    <Button DockPanel.Dock="Right" x:Name="TroubleshootButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE9CE;" Margin="0,4,8,0" VerticalAlignment="Center"
                            ToolTip="{loc:T Why isn\'t my scanner listed?}"
                            AutomationProperties.Name="{loc:T Why isn\'t my scanner listed?}"
                            AutomationProperties.HelpText="{loc:T Opens the troubleshooter: checks what stops scanners from appearing}"
                            Click="Troubleshoot_Click" />
                    <Button DockPanel.Dock="Right" x:Name="AddScannerButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE710;" Margin="0,4,2,0" VerticalAlignment="Center"
                            ToolTip="{loc:T Add a network scanner}"
                            AutomationProperties.Name="{loc:T Add a network scanner by address}"
                            Click="AddScanner_Click" />
                    <TextBlock x:Name="ScannersHeader" Text="{loc:T Scanners}" Style="{StaticResource BodyStrongText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="16,8,16,6"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="DeviceList" Style="{StaticResource NavListBoxStyle}" MaxHeight="220"
                         ItemContainerStyle="{StaticResource DeviceListItemStyle}"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="{loc:T Scanners}" ToolTipService.ShowOnDisabled="True"
                         SelectionChanged="DeviceList_SelectionChanged"
                         PreviewMouseLeftButtonDown="DeviceList_PreviewMouseDown"
                         PreviewKeyDown="DeviceList_PreviewKeyDown"
                         ContextMenuOpening="DeviceList_ContextMenuOpening">
                    <!-- One row per scanner (DeviceRow). A scanner reached several ways (WIA, TWAIN,
                         network) shows its connection as a "via WIA" menu button instead of a caption;
                         the row's context menu offers the same choices (also in the folded rail).
                         The selected row also says whether it is connecting or failed (a state line,
                         a warning glyph and a Retry button); the folded rail keeps the glyph and tooltip. -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}"
                                           Text="&#xE8FE;" Margin="0,0,12,0" />
                                <StackPanel x:Name="Texts">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="StateLine" Text="{Binding StateLine}" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                               ToolTip="{Binding StateLine}" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar x:Name="ConnectingBar" IsIndeterminate="True" Width="48" Height="3"
                                                 HorizontalAlignment="Left" Margin="0,2,0,2" Visibility="Collapsed"
                                                 AutomationProperties.Name="{loc:T Connecting…}" />
                                    <TextBlock x:Name="CaptionLine" Text="{Binding Caption}" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="ConnectionButton" Style="{StaticResource ConnectionChooserButtonStyle}"
                                            Content="{Binding Caption}" Visibility="Collapsed"
                                            IsTabStop="{Binding IsTabStop, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            ToolTip="{loc:T Choose how to connect to this scanner}"
                                            AutomationProperties.Name="{Binding ConnectionChooserName}"
                                            AutomationProperties.HelpText="{loc:T Opens a menu: Automatic\, or one of the ways this scanner is connected}"
                                            Click="ConnectionButton_Click" />
                                    <Button x:Name="RetryButton" Style="{StaticResource SubtleButtonStyle}" Content="{loc:T Retry}"
                                            FontFamily="{StaticResource SmallFontFamily}" FontSize="12" Padding="4,0,4,1"
                                            Margin="-5,2,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                            IsTabStop="{Binding IsTabStop, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            ToolTip="{loc:T Try to connect to this scanner again}"
                                            AutomationProperties.Name="{Binding RetryName}"
                                            AutomationProperties.HelpText="{loc:T Try to connect to this scanner again}"
                                            Click="RetryButton_Click" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                    <Setter TargetName="StateLine" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ConnectingBar" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="Failed">
                                    <Setter TargetName="StateLine" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="RetryButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasConnectionChoice}" Value="True">
                                    <Setter TargetName="CaptionLine" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ConnectionButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaneCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                    <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                    <!-- The icon rail shows no name: the scanner's name is its tooltip there. -->
                                    <Setter TargetName="Glyph" Property="ToolTip" Value="{Binding StateName}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The empty state while no scanner but the demo scanner is listed (shown from code:
                     UpdateEmptyDevicesHint); the + in the header adds one by address. -->
                <TextBlock Grid.Row="2" x:Name="EmptyDevicesHint" Margin="16,4" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}" Visibility="Collapsed"><Run
                        Text="{loc:T No scanner found}" /><LineBreak /><Hyperlink
                        x:Name="EmptyTroubleshootLink" Click="Troubleshoot_Click"
                        AutomationProperties.Name="{loc:T Troubleshoot: why isn\'t my scanner listed?}"><Run Text="{loc:T Troubleshoot}" /></Hyperlink>
                </TextBlock>

                <DockPanel Grid.Row="3" x:Name="PresetsHeader" Margin="16,16,8,4">
                    <StackPanel DockPanel.Dock="Right" x:Name="PresetButtons" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;"
                                ToolTip="{loc:T Save settings as a preset}"
                                AutomationProperties.Name="{loc:T Save the current settings as a preset}"
                                Click="SavePreset_Click" />
                        <Button x:Name="DeletePresetButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74D;"
                                ToolTip="{loc:T Delete preset}"
                                AutomationProperties.Name="{loc:T Delete preset}"
                                Click="DeletePreset_Click" />
                    </StackPanel>
                    <TextBlock Text="{loc:T Presets}" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Takes the presets header's place in the icon rail. -->
                <Border Grid.Row="3" x:Name="PresetsDivider" Height="1" Margin="12,12,12,8" Visibility="Collapsed"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ListBox Grid.Row="4" x:Name="PresetList" Style="{StaticResource NavListBoxStyle}"
                         AutomationProperties.Name="{loc:T Presets}"
                         SelectionChanged="PresetList_SelectionChanged"
                         PreviewKeyDown="PresetList_PreviewKeyDown"
                         MouseDoubleClick="PresetList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <DockPanel.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource PresetSummaryConverter}}" />
                                        <TextBlock Text="{loc:T Double-click or press Enter to apply}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel.ToolTip>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
                                            <Setter Property="Text" Value="&#xE8A5;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.Intent}" Value="Photo">
                                                    <Setter Property="Text" Value="&#xEB9F;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Up to two lines; the settings it holds are in the tooltip. -->
                                <StackPanel x:Name="Texts">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPaneCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                    <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="5">
                    <!-- Pair a phone, the paired phones and the networks receiving is allowed on. -->
                    <Button x:Name="PhoneButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE8EA;" Content="{loc:T Phone}"
                            ToolTip="{loc:T Send documents from your iPhone or iPad to this PC}"
                            AutomationProperties.HelpText="{loc:T Opens the phone settings: pair a phone\, the paired phones and the networks this PC receives on}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,0"
                            Click="PhoneButton_Click" />
                    <Button x:Name="AppearanceButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE793;" Content="{loc:T Appearance}"
                            ToolTip="{loc:T Light\, dark\, or follow Windows}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,0"
                            Click="AppearanceButton_Click" />
                    <Button x:Name="AboutButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE946;" Content="{loc:T About}"
                            ToolTip="{loc:T About Lazy Scan}"
                            AutomationProperties.Name="{loc:T About Lazy Scan}"
                            AutomationProperties.HelpText="{loc:T Shows the version\, support address and licenses}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,8"
                            Click="AboutButton_Click" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Style="{StaticResource PivotTabControlStyle}"
                        SelectionChanged="MainTabs_SelectionChanged">
                <!-- Start: what are you scanning? Task cards and the user's presets. -->
                <TabItem Header="{loc:T Start}" x:Name="StartTab" local:Icon.Glyph="&#xE80F;">
                    <local:TaskStartView x:Name="StartView" />
                </TabItem>

                <!-- Scan: preview canvas + page strip, with the inspector on the right -->
                <TabItem Header="{loc:T Scan}" x:Name="ScanTab" local:Icon.Glyph="&#xE8FE;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The active task: what to do now. Change task goes back to the start
                                 screen; the close button leaves the task, keeping its settings. -->
                            <Border Grid.Row="0" x:Name="TaskBanner" Style="{StaticResource TaskBannerStyle}"
                                    Margin="12,12,12,0" Visibility="Collapsed" SizeChanged="TaskBanner_SizeChanged">
                                <GroupBox x:Name="TaskBannerGroup" Style="{StaticResource TaskBannerGroupStyle}"
                                          AutomationProperties.LiveSetting="Polite">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="ExitTaskButton" Style="{StaticResource SmallIconButtonStyle}"
                                                Content="&#xE711;" VerticalAlignment="Center" Margin="2,0,0,0"
                                                ToolTip="{loc:T Leave the task (settings stay)}"
                                                AutomationProperties.Name="{loc:T Leave the task}"
                                                Click="ExitTask_Click" />
                                        <Button DockPanel.Dock="Right" x:Name="ChangeTaskButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE80F;" Content="{loc:T Change task}" VerticalAlignment="Center"
                                                Margin="8,0,0,0" ToolTip="{loc:T Pick another task}"
                                                Click="ChangeTask_Click" />
                                        <Border DockPanel.Dock="Left" x:Name="TaskBannerBadge" Style="{StaticResource TaskIconBadgeStyle}"
                                                Width="32" Height="32" VerticalAlignment="Center" CornerRadius="6">
                                            <TextBlock x:Name="TaskBannerGlyph" Style="{StaticResource TaskIconGlyphStyle}" FontSize="16" />
                                        </Border>
                                        <StackPanel x:Name="TaskBannerTexts" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- The task, and for a task of several steps where it is: "Front · Back · Check". -->
                                            <WrapPanel>
                                                <TextBlock x:Name="TaskBannerTitle" Style="{StaticResource BodyStrongText}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                <TextBlock x:Name="TaskBannerSteps" Style="{StaticResource SecondaryBodyText}"
                                                           TextWrapping="NoWrap" Visibility="Collapsed" />
                                            </WrapPanel>
                                            <!-- What to do now, in a line; the fuller guidance behind the ⓘ right after it. -->
                                            <DockPanel HorizontalAlignment="Left">
                                                <local:InfoButton x:Name="TaskBannerInfo" DockPanel.Dock="Right" Margin="4,-2,0,-2"
                                                                  VerticalAlignment="Top" Visibility="Collapsed" />
                                                <TextBlock x:Name="TaskBannerPrompt" Style="{StaticResource SecondaryBodyText}"
                                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            </DockPanel>
                                            <!-- Turning a stack over by hand: moving on from the fronts, the
                                                 backs' choices, and the count mismatch ("3 fronts but 2 backs")
                                                 when there is one. -->
                                            <StackPanel x:Name="SidesActions" Visibility="Collapsed" Margin="0,6,0,0">
                                                <DockPanel x:Name="SidesNotice" Visibility="Collapsed" Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="SidesNoticeText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                               AutomationProperties.LiveSetting="Assertive" />
                                                </DockPanel>
                                                <WrapPanel Margin="-11,0,0,0">
                                                    <Button x:Name="FinishFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8AB;" Content="{loc:T Done with fronts}" Margin="0,0,4,0"
                                                            ToolTip="{loc:T Every front side is scanned: turn the stack over and scan the back sides}"
                                                            Click="FinishFronts_Click" />
                                                    <Button x:Name="CombineSidesButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE73E;" Content="{loc:T Combine anyway}" Margin="0,0,4,0"
                                                            ToolTip="{loc:T Put the pages in order as they are; the extra pages go at the end}"
                                                            Click="CombineSides_Click" />
                                                    <Button x:Name="ScanBacksAgainButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE72C;" Content="{loc:T Scan back sides again}" Margin="0,0,4,0"
                                                            ToolTip="{loc:T Remove the back sides scanned so far and scan them again}"
                                                            Click="ScanBacksAgain_Click" />
                                                    <Button x:Name="MoreFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE710;" Content="{loc:T Scan more fronts}" Margin="0,0,4,0"
                                                            ToolTip="{loc:T The stack did not fit in the feeder: scan the fronts of the other sheets before turning it over}"
                                                            Click="MoreFronts_Click" />
                                                    <Button x:Name="KeepFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8A5;" Content="{loc:T Keep fronts only}"
                                                            ToolTip="{loc:T Leave out the back sides: the fronts stay as they are}"
                                                            Click="KeepFronts_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <!-- A step that may be left out (the back of a card with
                                                 nothing printed on it). -->
                                            <WrapPanel x:Name="StepActions" Visibility="Collapsed" Margin="-11,6,0,0">
                                                <Button x:Name="SkipStepButton" Style="{StaticResource SubtleButtonStyle}"
                                                        local:Icon.Glyph="&#xE72A;" Content="{loc:T Skip}"
                                                        Click="SkipStep_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </GroupBox>
                            </Border>

                            <!-- Stage: the page sits on a neutral surface with a soft shadow. -->
                            <Border Grid.Row="1" Style="{StaticResource StageStyle}" Margin="12,12,12,0">
                                <local:FocusHost x:Name="CanvasHost" Focusable="True"
                                      AutomationProperties.Name="{loc:T Page view}"
                                      AutomationProperties.HelpText="{loc:T Use the arrow keys to scroll or change page.}"
                                      FocusVisualStyle="{StaticResource StageFocusVisualStyle}"
                                      PreviewKeyDown="CanvasHost_PreviewKeyDown"
                                      MouseLeftButtonDown="Canvas_MouseDown"
                                      MouseMove="Canvas_MouseMove"
                                      MouseLeftButtonUp="Canvas_MouseUp"
                                      LostMouseCapture="Canvas_LostMouseCapture"
                                      SizeChanged="CanvasHost_SizeChanged"
                                      Background="Transparent">
                                    <!-- The margin must stay uniform: DisplayedImageRect reads Margin.Left for every side. -->
                                    <ScrollViewer x:Name="CanvasScroll" Focusable="False" PanningMode="None" FlowDirection="LeftToRight"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="CanvasScroll_PreviewMouseWheel">
                                        <Image x:Name="CanvasImage" Stretch="Uniform" Margin="24" FlowDirection="LeftToRight"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Effect="{DynamicResource PageShadow}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </ScrollViewer>
                                    <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" FlowDirection="LeftToRight">
                                        <Rectangle x:Name="SelectionMarquee"
                                                   Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                                   StrokeDashArray="4 3" Fill="{DynamicResource MarqueeFillBrush}"
                                                   Visibility="Collapsed" />
                                    </Canvas>
                                    <!-- After a preview, until an area is selected: the preview can be dragged over. -->
                                    <Border x:Name="DragChip" Visibility="Collapsed" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
                                            Padding="10,4,12,5" CornerRadius="12" BorderThickness="1"
                                            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8B3;" Margin="0,1,6,0" />
                                            <TextBlock Text="{x:Static local:ShortText.DragToSelect}" Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- With pages queued: the live canvas, or one queued page large (picked in the strip). -->
                                    <Border x:Name="PageSwitch" Visibility="Collapsed" Style="{StaticResource SegmentedTrackStyle}"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0"
                                            CornerRadius="12" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                            AutomationProperties.Name="{loc:T Canvas view}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ShowPreviewButton" Style="{StaticResource SegmentedTextItemStyle}"
                                                         Content="{loc:T Preview}" GroupName="CanvasView" IsChecked="True"
                                                         Padding="12,4" Checked="PageSwitch_Changed" />
                                            <RadioButton x:Name="ShowPageButton" Style="{StaticResource SegmentedTextItemStyle}"
                                                         Content="{loc:T Page}" GroupName="CanvasView"
                                                         Padding="12,4" Checked="PageSwitch_Changed" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Over the image: zoom out and in, back to fitting the window, full size. -->
                                    <Border x:Name="ZoomPill" Visibility="Collapsed"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                                            Padding="4" CornerRadius="12" BorderThickness="1"
                                            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:T Zoom}">
                                            <Button x:Name="ZoomOutButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE738;"
                                                    ToolTip="{loc:T Zoom out (Ctrl+Minus)}" AutomationProperties.Name="{loc:T Zoom out}"
                                                    Click="ZoomOut_Click" />
                                            <Button x:Name="ZoomFitButton" Style="{StaticResource SubtleButtonStyle}" Content="{loc:T Fit}"
                                                    Height="28" Padding="10,0" Margin="4,0,0,0"
                                                    ToolTip="{loc:T Fit the page to the window (Ctrl+0)}"
                                                    Click="ZoomFit_Click" />
                                            <Button x:Name="ZoomFullButton" Style="{StaticResource SubtleButtonStyle}" Content="{loc:T 100%}"
                                                    Height="28" Padding="10,0" Margin="4,0,0,0"
                                                    ToolTip="{loc:T Show the page at full size (Ctrl+1)}"
                                                    Click="ZoomFull_Click" />
                                            <Button x:Name="ZoomInButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;"
                                                    Margin="4,0,0,0"
                                                    ToolTip="{loc:T Zoom in (Ctrl+Plus)}" AutomationProperties.Name="{loc:T Zoom in}"
                                                    Click="ZoomIn_Click" />
                                            <TextBlock x:Name="ZoomReadout" Style="{StaticResource CaptionText}" Width="40"
                                                       TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,6,0"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PageProblem" Visibility="Collapsed" IsHitTestVisible="False"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,72,24,0"
                                            Padding="10,4,12,5" CornerRadius="12" BorderThickness="1"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                        <TextBlock x:Name="PageProblemText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <StackPanel x:Name="CanvasHint" Style="{StaticResource EmptyStatePanelStyle}">
                                        <Border x:Name="CanvasHintGlyph" Style="{StaticResource EmptyStateCircleStyle}">
                                            <TextBlock Style="{StaticResource EmptyStateGlyphStyle}" Text="&#xE8FE;" />
                                        </Border>
                                        <!-- The title and the line are hidden while a task banner says what to do. -->
                                        <TextBlock x:Name="CanvasHintTitle" Text="{loc:T Ready to scan}"
                                                   Style="{StaticResource EmptyStateTitleStyle}" />
                                        <TextBlock x:Name="CanvasHintBody" Style="{StaticResource EmptyStateBodyStyle}"
                                                   Text="{x:Static local:ShortText.PlaceOriginal}" />
                                        <!-- No scanner needed: photos of documents become pages too (PhotoImport). -->
                                        <StackPanel x:Name="CanvasImport" Margin="0,16,0,0" HorizontalAlignment="Center">
                                            <Button x:Name="CanvasImportButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xEB9F;" HorizontalAlignment="Center"
                                                    Click="ImportPhotos_Click" />
                                            <TextBlock x:Name="CanvasDropHint" Style="{StaticResource CaptionText}" TextAlignment="Center"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:FocusHost>
                            </Border>

                            <!-- Page strip -->
                            <Border Grid.Row="2" x:Name="PageStrip" Background="Transparent" Visibility="Collapsed"
                                    Padding="12,8,12,8">
                                <StackPanel>
                                    <TextBlock x:Name="PageStripLabel" Text="{loc:T 0 pages}" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" Margin="2,0,0,6" />
                                    <!-- Tab walks through every page's buttons (a ListBox would
                                         otherwise take one tab stop and skip them). -->
                                    <ListBox x:Name="PageList" Height="158"
                                             AutomationProperties.Name="{loc:T Pages in queue}"
                                             KeyboardNavigation.TabNavigation="Continue"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             SelectionChanged="PageList_SelectionChanged"
                                             AllowDrop="True" PreviewMouseLeftButtonDown="PageList_PreviewMouseDown"
                                             PreviewMouseMove="PageList_PreviewMouseMove" PreviewMouseLeftButtonUp="PageList_PreviewMouseUp"
                                             DragOver="PageList_DragOver" DragLeave="PageList_DragLeave" Drop="PageList_Drop"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             BorderThickness="0" Background="Transparent" Padding="0,0,0,16">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThumbnailListItemStyle}">
                                                <Setter Property="AutomationProperties.HelpText" Value="{Binding RescanHelp}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal" VirtualizationMode="Recycling" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <!-- The gap before the page, shown while the strip shows documents:
                                                         one click starts a new document here or joins the page to the
                                                         document before. A document's start is drawn as a bar. -->
                                                    <Button x:Name="BreakButton" DockPanel.Dock="Left" Width="18" Margin="0,0,3,0" VerticalAlignment="Stretch"
                                                            MinHeight="0" Padding="0"
                                                            Cursor="Hand" ToolTip="{Binding BreakToolTip}"
                                                            AutomationProperties.Name="{Binding BreakLabel}"
                                                            Click="PageBreak_Click" Tag="{Binding Page.Id}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid>
                                                            <Rectangle x:Name="BreakLine" Width="1" Margin="0,10,0,10"
                                                                       Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0" />
                                                            <!-- Scissors to split here, a link to join; shown on hover and focus. -->
                                                            <Border x:Name="BreakGlyphBack" Width="18" Height="18" CornerRadius="9" Opacity="0"
                                                                    VerticalAlignment="Center" BorderThickness="1"
                                                                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                                                <TextBlock x:Name="BreakGlyph" Style="{StaticResource GlyphText}" FontSize="10"
                                                                           HorizontalAlignment="Center" Text="&#xE8C6;" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                    <!-- Where the next scan goes, before the page it replaces. -->
                                                    <Line x:Name="RescanMarker" DockPanel.Dock="Left" Visibility="Collapsed" IsHitTestVisible="False"
                                                          X1="1.5" X2="1.5" Y1="0" Y2="1" Stretch="Fill" Width="3" Margin="0,0,3,0"
                                                          StrokeThickness="3" StrokeDashArray="2 1"
                                                          Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <Grid Width="116" Height="128">
                                                    <!-- The page's text, read with OCR, on the clipboard. -->
                                                    <!-- Split or join the documents at the page, and name its document. -->
                                                    <!-- A page of a book: split its spread (again), or join its two pages. -->
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{loc:T Copy text}" Click="PageCopyText_Click" Tag="{Binding Page.Id}" />
                                                            <Separator />
                                                            <MenuItem Header="{loc:T Scan again}"
                                                                      Visibility="{Binding CanScanAgain, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageScanAgain_Click" Tag="{Binding Page.Id}" />
                                                            <MenuItem Header="{loc:T Cancel scan again}"
                                                                      Visibility="{Binding IsRescanTarget, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageCancelScanAgain_Click" Tag="{Binding Page.Id}" />
                                                            <Separator Visibility="{Binding HasSplitMenu, Converter={StaticResource BoolToVisibility}}" />
                                                            <MenuItem Header="{Binding MenuBreakLabel}"
                                                                      Visibility="{Binding HasMenuBreak, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageBreak_Click" Tag="{Binding Page.Id}" />
                                                            <MenuItem Header="{loc:T Name this document…}"
                                                                      Visibility="{Binding CanNameDocument, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageName_Click" Tag="{Binding Page.Id}" />
                                                            <Separator Visibility="{Binding HasSplitSpread, Converter={StaticResource BoolToVisibility}}" />
                                                            <MenuItem Header="{Binding SplitSpreadLabel}"
                                                                      Visibility="{Binding HasSplitSpread, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageSplitSpread_Click" Tag="{Binding Page.Id}" />
                                                            <MenuItem Header="{Binding JoinSpreadLabel}"
                                                                      Visibility="{Binding HasJoinSpread, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageJoinSpread_Click" Tag="{Binding Page.Id}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="6"
                                                            ToolTip="{Binding SourceToolTip}">
                                                        <Image x:Name="Thumb" Source="{Binding Thumbnail}" MaxHeight="112" MaxWidth="104" FlowDirection="LeftToRight"
                                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <!-- A page that looks blank, or was skipped: what saving does with
                                                         it, and one click (always shown) to keep or skip it. -->
                                                    <StackPanel x:Name="BlankInfo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="0,0,0,10">
                                                        <Border x:Name="BlankBadge" HorizontalAlignment="Center" Padding="6,1,6,2"
                                                                CornerRadius="4" ToolTip="{Binding BadgeToolTip}"
                                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7C3;" FontSize="11"
                                                                           Margin="0,1,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding BlankBadge}" Style="{StaticResource CaptionText}"
                                                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button x:Name="BlankToggle" Style="{StaticResource PageToggleButtonStyle}"
                                                                Content="{Binding ToggleText}"
                                                                ToolTip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}"
                                                                HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                Click="PageToggle_Click" Tag="{Binding Page.Id}" />
                                                    </StackPanel>
                                                    <!-- A spread whose spine was not found, or that was joined: kept whole, and
                                                         one click away from the split dialog. -->
                                                    <StackPanel x:Name="SpreadInfo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="0,0,0,10" Visibility="Collapsed">
                                                        <Border HorizontalAlignment="Center" Padding="6,1,6,2" CornerRadius="4"
                                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <TextBlock Text="{x:Static core:BookPages.NotSplitBadge}" Style="{StaticResource CaptionText}"
                                                                       TextWrapping="NoWrap" />
                                                        </Border>
                                                        <Button x:Name="SplitSpreadButton" Style="{StaticResource PageToggleButtonStyle}"
                                                                Content="{loc:T Split…}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                AutomationProperties.Name="{Binding SplitSpreadLabel}"
                                                                Click="PageSplitSpread_Click" Tag="{Binding Page.Id}" />
                                                    </StackPanel>
                                                    <!-- The top row: which side of which sheet on the left, and
                                                         the swap button on the right. The side badge takes the
                                                         room the button leaves, and wraps rather than cover it. -->
                                                    <DockPanel x:Name="TopRow" VerticalAlignment="Top" Margin="4,4,4,0">
                                                        <!-- A page crop and straighten changed: one click shows it as
                                                             scanned, and back. Always shown, on the page itself. -->
                                                        <Button x:Name="GeometryToggle" DockPanel.Dock="Right" Style="{StaticResource PageToggleButtonStyle}"
                                                                VerticalAlignment="Top" Margin="2,0,0,0"
                                                                Padding="4,2,4,2" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                                                Content="{Binding GeometryGlyph}"
                                                                ToolTip="{Binding GeometryToolTip}"
                                                                AutomationProperties.Name="{Binding GeometryToggleLabel}"
                                                                AutomationProperties.HelpText="{Binding GeometryCaption}"
                                                                Click="PageGeometry_Click" Tag="{Binding Page.Id}" />
                                                        <!-- A page turned upright: one click turns it back as scanned, and
                                                             again. Always shown, on the page itself. -->
                                                        <Button x:Name="UprightToggle" DockPanel.Dock="Right" Style="{StaticResource PageToggleButtonStyle}"
                                                                VerticalAlignment="Top" Margin="2,0,0,0"
                                                                Padding="4,2,4,2" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                                                Content="&#xE72C;"
                                                                ToolTip="{Binding UprightToolTip}"
                                                                AutomationProperties.Name="{Binding UprightToggleLabel}"
                                                                AutomationProperties.HelpText="{Binding UprightCaption}"
                                                                Click="PageUpright_Click" Tag="{Binding Page.Id}" />
                                                        <StackPanel>
                                                            <!-- The first page of each document when the queue is split:
                                                                 "Document 2 · Lease" (the full name on hover). -->
                                                            <!-- The next scan replaces this page. -->
                                                            <Border x:Name="RescanBadge" Style="{StaticResource AccentTagStyle}" Visibility="Collapsed"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,2" IsHitTestVisible="False">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE72C;" FontSize="11"
                                                                               Margin="0,1,4,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{loc:T Replacing}" Style="{StaticResource AccentTagText}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border x:Name="DocumentBadge" Style="{StaticResource AccentTagStyle}"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,2" ToolTip="{Binding DividerTitle}">
                                                                <TextBlock Text="{Binding DividerTitle}" Style="{StaticResource AccentTagText}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="96" />
                                                            </Border>
                                                            <!-- Which side of which sheet, for two-sided stacks; which spread, for books. -->
                                                            <Border x:Name="SideBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Padding="5,0,5,1" CornerRadius="4" IsHitTestVisible="False"
                                                                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource CaptionText}"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Border x:Name="Actions" Style="{StaticResource HoverActionBarStyle}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76B;"
                                                                    ToolTip="{Binding MoveLeftLabel}"
                                                                    AutomationProperties.Name="{Binding MoveLeftLabel}"
                                                                    Click="PageLeft_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE7AD;"
                                                                    ToolTip="{loc:T Rotate page 90° clockwise}"
                                                                    AutomationProperties.Name="{loc:T Rotate page 90° clockwise}"
                                                                    Click="PageRotate_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE74D;"
                                                                    ToolTip="{loc:T Remove page}"
                                                                    AutomationProperties.Name="{loc:T Remove page}"
                                                                    Click="PageRemove_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76C;"
                                                                    ToolTip="{Binding MoveRightLabel}"
                                                                    AutomationProperties.Name="{Binding MoveRightLabel}"
                                                                    Click="PageRight_Click" Tag="{Binding Page.Id}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- The document's name ({label} in the file name), typed here. -->
                                                    <Popup x:Name="NamePopup" IsOpen="{Binding IsNaming, Mode=TwoWay}" StaysOpen="False"
                                                           PlacementTarget="{Binding ElementName=Card}" Placement="Top" AllowsTransparency="True"
                                                           Opened="NamePopup_Opened" Closed="NamePopup_Closed" Tag="{Binding Page.Id}">
                                                        <Border Style="{StaticResource CardStyle}" Padding="8" Width="240">
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:T Name this document}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                                <TextBox x:Name="NameBox" Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="{x:Static core:DocumentSplitter.MaxLabelLength}"
                                                                         AutomationProperties.Name="{loc:T Name this document}"
                                                                         KeyDown="NameBox_KeyDown" Tag="{Binding Page.Id}" />
                                                                <TextBlock Text="{loc:T Goes into the file name. Enter saves\, Esc cancels.}"
                                                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRescanTarget}" Value="True">
                                                        <Setter TargetName="RescanMarker" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="RescanBadge" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeText}" Value="{x:Null}">
                                                        <Setter TargetName="SideBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNotSplit}" Value="True">
                                                        <Setter TargetName="SpreadInfo" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasSplitSpread}" Value="False">
                                                        <Setter TargetName="SplitSpreadButton" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DividerTitle}" Value="{x:Null}">
                                                        <Setter TargetName="DocumentBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StartsDocument}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                        <Setter TargetName="BreakLine" Property="Width" Value="3" />
                                                        <Setter TargetName="BreakLine" Property="Margin" Value="0" />
                                                        <Setter TargetName="BreakLine" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter TargetName="BreakGlyph" Property="Text" Value="&#xE71B;" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BreakButton}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                        <Setter TargetName="BreakGlyphBack" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BreakButton}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                        <Setter TargetName="BreakGlyphBack" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsBreaks}" Value="False">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsBreaks}" Value="True">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasBreakButton}" Value="True">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding BlankBadge}" Value="{x:Null}">
                                                        <Setter TargetName="BlankBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ToggleLabel}" Value="{x:Null}">
                                                        <Setter TargetName="BlankToggle" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GeometryToggleLabel}" Value="{x:Null}">
                                                        <Setter TargetName="GeometryToggle" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UprightToggleLabel}" Value="{x:Null}">
                                                        <Setter TargetName="UprightToggle" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <!-- Left out when saving: the page is dimmed. -->
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                    <!-- Last, so it wins: a frozen page shows no actions. -->
                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Inspector: the settings scroll; the action buttons are pinned below
                             them so Preview/Scan can never be pushed out of the window. The sections
                             (Expanders, headers built in MainWindow.Inspector.cs) open and close as the
                             user left them; a collapsed one shows a summary of what is on. Controls that
                             do nothing for the task or format are hidden; ones that conflict with another
                             choice are greyed out with a short reason next to them. -->
                        <Grid Grid.Column="1" Width="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0" />
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12" x:Name="Inspector">
                                    <Border x:Name="ModeTrack" Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,12"
                                            AutomationProperties.Name="{loc:T Scan mode}" ToolTipService.ShowOnDisabled="True">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ModeDocument" Style="{StaticResource SegmentedItemStyle}"
                                                         Content="{loc:T Document}" local:Icon.Glyph="&#xE8A5;" IsChecked="True"
                                                         AutomationProperties.HelpText="{loc:T Document: pages and text. Photos: finds each photo on the glass.}"
                                                         Checked="Setting_Changed" />
                                            <RadioButton x:Name="ModePhotos" Style="{StaticResource SegmentedItemStyle}"
                                                         Content="{loc:T Photos}" local:Icon.Glyph="&#xEB9F;"
                                                         AutomationProperties.HelpText="{loc:T Document: pages and text. Photos: finds each photo on the glass.}"
                                                         Checked="Setting_Changed" />
                                        </UniformGrid>
                                    </Border>

                                    <!-- The Copy task only: where and how the copies print. Nothing opens a print
                                         dialog; the printer list and paper are read from Windows. -->
                                    <Expander x:Name="CopyOptions" Style="{StaticResource SectionExpanderStyle}"
                                              AutomationProperties.Name="{loc:T Photocopy}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T Printer}" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="CopyPrinterBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Printer}"
                                                      DropDownOpened="CopyPrinterBox_DropDownOpened"
                                                      SelectionChanged="CopyPrinter_Changed" />
                                            <TextBlock x:Name="CopyPaperText" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <DockPanel x:Name="CopyNoPrinterNotice" Margin="0,4,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="CopyNoPrinterText" Style="{StaticResource ReasonText}"
                                                           Text="{loc:T No printer is installed. Add one in Windows Settings\, then look again.}" />
                                            </DockPanel>
                                            <Button x:Name="CopyLookAgainButton" Style="{StaticResource SubtleButtonStyle}"
                                                    Content="{loc:T Look again}" HorizontalAlignment="Left" Margin="-11,4,0,0"
                                                    Visibility="Collapsed"
                                                    ToolTip="{loc:T Reads the installed printers again}"
                                                    Click="CopyLookAgain_Click" />
                                            <TextBlock Text="{loc:T Copies}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="CopyCountBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Number of copies}"
                                                      SelectionChanged="CopyCount_Changed" />
                                            <CheckBox x:Name="CopyFitBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                                                      Content="{loc:T Fit to page}"
                                                      ToolTip="{loc:T Off: real size. On: shrinks to fit the paper.}"
                                                      Checked="CopyFit_Changed" Unchecked="CopyFit_Changed" />
                                            <!-- Shown while copies print at real size: edges a printer can't reach are lost. -->
                                            <DockPanel x:Name="CopyMarginNotice" Margin="0,2,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="CopyMarginText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <CheckBox x:Name="CopyPdfBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                      Content="{loc:T Also save a PDF}"
                                                      ToolTip="{loc:T Keeps a PDF of each copy in your save folder}"
                                                      AutomationProperties.HelpText="{loc:T Each copy is also saved as a PDF in the save folder}"
                                                      Checked="CopyPdf_Changed" Unchecked="CopyPdf_Changed" />
                                            <Button x:Name="RulerButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE749;"
                                                    Content="{loc:T Print test ruler}" HorizontalAlignment="Left" Margin="-11,8,0,0"
                                                    ToolTip="{loc:T Prints a ruler to check copies come out at real size}"
                                                    AutomationProperties.Name="{loc:T Print ruler test page}"
                                                    AutomationProperties.HelpText="{loc:T Prints a 1-inch grid with centimeter ticks: measure it with a ruler to check that copies come out at real size}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Click="RulerPage_Click" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- The Receipts task only: how the receipts found on the glass are named and saved. -->
                                    <Expander x:Name="ReceiptOptions" Style="{StaticResource SectionExpanderStyle}"
                                              AutomationProperties.Name="{loc:T Receipts}" Visibility="Collapsed">
                                        <StackPanel>
                                            <CheckBox x:Name="ReceiptDateBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Name by receipt date}"
                                                      ToolTip="{loc:T Uses the date printed on the receipt\, or today}"
                                                      Checked="ReceiptDate_Changed" Unchecked="ReceiptDate_Changed" />
                                            <DockPanel x:Name="ReceiptDateReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.NeedsDocDate}" />
                                            </DockPanel>
                                            <CheckBox x:Name="ReceiptCombineBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                      Content="{loc:T One PDF for all}" ToolTipService.ShowOnDisabled="True"
                                                      Checked="ReceiptCombine_Changed" Unchecked="ReceiptCombine_Changed" />
                                            <DockPanel x:Name="ReceiptCombineReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.OnlyForPdfs}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Scanner: where the paper is, its sides and size, and how it is read. -->
                                    <Expander x:Name="ScannerSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Scanner}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:T Source}" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="SourceBox" Margin="{StaticResource FieldSpacing}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T Source}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="Setting_Changed" />
                                            <!-- Feeder sheets: one side, both, or turned over by hand. Left out for a
                                                 scanner without a feeder; on its flatbed, greyed out with the reason. -->
                                            <StackPanel x:Name="SidesOptions" Margin="{StaticResource FieldSpacing}">
                                                <TextBlock Text="{loc:T Sides}" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="SidesBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{loc:T Sides}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          SelectionChanged="Sides_Changed" />
                                                <DockPanel x:Name="SidesReason" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                    <TextBlock x:Name="SidesHint" Style="{StaticResource ReasonText}" />
                                                </DockPanel>
                                                <StackPanel x:Name="BackBindingOptions" Margin="0,8,0,0">
                                                    <TextBlock Text="{loc:T Flip on}" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="BackBindingBox" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="{loc:T Back sides flip on}"
                                                              AutomationProperties.HelpText="{loc:T How the sheets turn: the backs of short-edge sheets are turned upright.}"
                                                              ToolTip="{x:Static core:DuplexBindings.PickerHint}"
                                                              SelectionChanged="Sides_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{loc:T Paper size}" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PaperSizeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Paper size}"
                                                      SelectionChanged="PaperSize_Changed" />
                                            <!-- Live state: an area selected on the preview is scanned instead of the paper size. -->
                                            <DockPanel x:Name="SelectedAreaRow" Margin="0,2,0,0" Visibility="Collapsed">
                                                <Button DockPanel.Dock="Right" x:Name="ClearSelectionButton" Style="{StaticResource SmallIconButtonStyle}"
                                                        Content="&#xE711;" Width="24" Height="24" FontSize="11"
                                                        ToolTip="{loc:T Clear the selection}"
                                                        AutomationProperties.Name="{loc:T Clear the selected area}"
                                                        Click="ClearSelection_Click" />
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE8B3;" />
                                                <TextBlock x:Name="PaperSizeHint" Style="{StaticResource ReasonText}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{loc:T Resolution}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Resolution}" ItemStringFormat="{loc:T {}{0} dpi}"
                                                      ToolTip="{loc:T Higher is sharper but slower and larger. 300 suits documents.}"
                                                      SelectionChanged="Setting_Changed" />
                                            <TextBlock Text="{loc:T Color}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ColorModeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Color}" SelectionChanged="Setting_Changed" />
                                            <!-- TWAIN connections only: scan through the driver's own window. -->
                                            <StackPanel x:Name="DriverWindowOptions" Visibility="Collapsed" Margin="0,8,0,0">
                                                <CheckBox x:Name="DriverWindowBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Use the scanner\'s own window}" ToolTipService.ShowOnDisabled="True"
                                                          Checked="DriverWindow_Changed" Unchecked="DriverWindow_Changed" />
                                                <DockPanel x:Name="DriverWindowReason" Visibility="Collapsed">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                    <TextBlock x:Name="DriverWindowHint" Style="{StaticResource ReasonText}" Text="{loc:T Always on for this driver}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Output (Document mode) or Photos (Photos mode): what is saved, and where. -->
                                    <Expander x:Name="OutputSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Output}">
                                        <StackPanel>
                                            <StackPanel x:Name="PhotoOptions" Visibility="Collapsed" Margin="0,0,0,8">
                                                <CheckBox x:Name="AutoSplitBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Find each photo}" IsChecked="True"
                                                          ToolTip="{loc:T Finds each photo on the glass and saves it on its own}"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                                <StackPanel x:Name="PhotoSteppers" Margin="12,0,0,0">
                                                    <Grid Margin="0,2,0,2" ToolTip="{loc:T Smaller pictures on the glass are ignored}"
                                                          PreviewKeyDown="PhotoStepper_KeyDown">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:T Min photo side}" Style="{StaticResource SliderLabelText}" />
                                                        <TextBlock Grid.Column="1" x:Name="MinSideValue" MinWidth="52" Margin="0,0,8,0"
                                                                   Style="{StaticResource ReadoutText}"
                                                                   AutomationProperties.Name="{loc:T Min photo side}"
                                                                   AutomationProperties.LiveSetting="Off" />
                                                        <Button Grid.Column="2" x:Name="MinSideDown" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE738;"
                                                                AutomationProperties.Name="{loc:T Decrease Min photo side}"
                                                                Click="PhotoStepper_Click" />
                                                        <Button Grid.Column="3" x:Name="MinSideUp" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;"
                                                                AutomationProperties.Name="{loc:T Increase Min photo side}"
                                                                Click="PhotoStepper_Click" />
                                                    </Grid>
                                                    <Grid Margin="0,2,0,2" ToolTip="{loc:T Cuts this many pixels off each photo edge}"
                                                          PreviewKeyDown="PhotoStepper_KeyDown">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:T Edge trim}" Style="{StaticResource SliderLabelText}" />
                                                        <TextBlock Grid.Column="1" x:Name="EdgeTrimValue" MinWidth="52" Margin="0,0,8,0"
                                                                   Style="{StaticResource ReadoutText}"
                                                                   AutomationProperties.Name="{loc:T Edge trim}"
                                                                   AutomationProperties.LiveSetting="Off" />
                                                        <Button Grid.Column="2" x:Name="EdgeTrimDown" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE738;"
                                                                AutomationProperties.Name="{loc:T Decrease Edge trim}"
                                                                Click="PhotoStepper_Click" />
                                                        <Button Grid.Column="3" x:Name="EdgeTrimUp" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;"
                                                                AutomationProperties.Name="{loc:T Increase Edge trim}"
                                                                Click="PhotoStepper_Click" />
                                                    </Grid>
                                                </StackPanel>
                                                <CheckBox x:Name="DeskewBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Straighten photos}" IsChecked="True"
                                                          AutomationProperties.HelpText="{loc:T Turns each photo found on the glass straight (deskew)}"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            </StackPanel>
                                            <StackPanel x:Name="FormatRow">
                                                <TextBlock Text="{loc:T Format}" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{loc:T Format}" SelectionChanged="Format_Changed" />
                                                <Grid x:Name="JpegQualityRow" Margin="0,4,0,0" ToolTip="{loc:T Lower is a smaller file\, higher keeps more detail}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="40" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:T JPEG quality}" Style="{StaticResource SliderLabelText}" />
                                                    <Slider Grid.Column="1" x:Name="JpegQualitySlider" Minimum="0.5" Maximum="1"
                                                            SmallChange="0.01" LargeChange="0.05"
                                                            AutomationProperties.Name="{loc:T JPEG quality}"
                                                            ValueChanged="Output_SliderChanged" />
                                                    <TextBlock Grid.Column="2" x:Name="JpegQualityReadout" Style="{StaticResource ReadoutText}" />
                                                </Grid>
                                            </StackPanel>
                                            <!-- Word output only: each page's picture before its text; label and
                                                 hint (as the tooltip) from DocxWriter in Core. -->
                                            <StackPanel x:Name="WordOptions" Margin="0,8,0,0" Visibility="Collapsed">
                                                <CheckBox x:Name="WordPageImagesBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            </StackPanel>
                                            <!-- PDF output, and the page pictures of a Word document: how small
                                                 the file is made. The segments (largest first) are added in code
                                                 from PdfSizePresets; each says what it does on hover. -->
                                            <StackPanel x:Name="PdfSizeOptions" Margin="0,12,0,0">
                                                <TextBlock x:Name="PdfSizeLabel" Text="{loc:T PDF size}" Style="{StaticResource FieldLabelText}" />
                                                <Border x:Name="PdfSizeTrack" Style="{StaticResource SegmentedTrackStyle}"
                                                        AutomationProperties.Name="{loc:T PDF size}">
                                                    <UniformGrid x:Name="PdfSizeSegments" Rows="1" />
                                                </Border>
                                                <!-- Live state: the size of the last PDF saved. -->
                                                <TextBlock x:Name="LastPdfSizeText" Style="{StaticResource CaptionText}"
                                                           TextWrapping="NoWrap" Margin="0,4,0,0"
                                                           Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                                            </StackPanel>
                                            <StackPanel x:Name="DocumentOptions" Margin="0,8,0,0">
                                                <CheckBox x:Name="SearchableBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Searchable PDF}"
                                                          ToolTip="{loc:T Lets you search and copy the text (OCR)}"
                                                          AutomationProperties.HelpText="{loc:T Text is recognized so the PDF can be searched and its text copied. Pick the language below if the page is not in your Windows language.}"
                                                          Checked="SearchableBox_Checked" Unchecked="Setting_Changed" />
                                                <StackPanel x:Name="OcrLanguageRow">
                                                    <TextBlock Text="{loc:T OCR language}" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="OcrLanguageBox" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="{loc:T OCR language}"
                                                              ToolTip="{loc:T Language used to read the text. Automatic tries every installed language pack.}"
                                                              ToolTipService.ShowOnDisabled="True"
                                                              SelectionChanged="OcrLanguage_Changed" />
                                                    <TextBlock x:Name="OcrLanguageHint" Style="{StaticResource CaptionText}"
                                                               Text="{loc:T No OCR language pack is installed. Add one in Settings → Time &amp; Language → Language.}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                                </StackPanel>
                                                <CheckBox x:Name="MultiPageBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Collect pages before saving}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            </StackPanel>
                                            <TextBlock Text="{loc:T Save to}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE838;"
                                                        ToolTip="{loc:T Choose the save folder}"
                                                        AutomationProperties.Name="{loc:T Choose the save folder}"
                                                        Click="BrowseDestination_Click" />
                                                <TextBox x:Name="DestinationBox" Margin="0,0,4,0" FlowDirection="LeftToRight"
                                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                         ScrollViewer.ScrollChanged="DestinationBox_ScrollChanged"
                                                         LostKeyboardFocus="DestinationBox_LostKeyboardFocus"
                                                         AutomationProperties.Name="{loc:T Save to}" LostFocus="Setting_Changed" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="AdjustmentsSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Adjustments}">
                                        <StackPanel>
                                            <CheckBox x:Name="AutoEnhanceBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Auto enhance}"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{loc:T Brightness}" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="{loc:T Brightness}"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BrightnessReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="1" Text="{loc:T Contrast}" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="1" Grid.Column="1" x:Name="ContrastSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="{loc:T Contrast}"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ContrastReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="2" Text="{loc:T Saturation}" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="2" Grid.Column="1" x:Name="SaturationSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="{loc:T Saturation}" ToolTipService.ShowOnDisabled="True"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SaturationReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="3" Text="{loc:T Sharpness}" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="3" Grid.Column="1" x:Name="SharpnessSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="{loc:T Sharpness}"
                                                        ToolTip="{loc:T Positive sharpens\, negative softens}"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SharpnessReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                            </Grid>
                                            <Button x:Name="ResetSlidersButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE7A7;" Content="{loc:T Reset}"
                                                    AutomationProperties.Name="{loc:T Reset sliders}"
                                                    HorizontalAlignment="Left" Margin="-11,4,0,4"
                                                    Click="ResetSliders_Click" />
                                            <TextBlock x:Name="SlidersNextScanNote" Style="{StaticResource SecondaryBodyText}"
                                                       Text="{loc:T These sliders apply to the next scan.}"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
                                            <CheckBox x:Name="DescreenBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Remove print dots}"
                                                      ToolTip="{loc:T Smooths the dot pattern of magazines and printed photos (descreen)}"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <CheckBox x:Name="RestoreBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Restore faded colors}" ToolTipService.ShowOnDisabled="True"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <DockPanel x:Name="ColorReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.NeedsColor}" />
                                            </DockPanel>
                                            <Grid x:Name="ThresholdRow" Margin="0,4,0,0" ToolTip="{loc:T Pixels lighter than this turn white\, darker turn black}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="40" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:T B&amp;W threshold}" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Column="1" x:Name="ThresholdSlider" Minimum="0" Maximum="1"
                                                        SmallChange="0.01" LargeChange="0.05"
                                                        AutomationProperties.Name="{loc:T B&amp;W threshold}"
                                                        ValueChanged="Output_SliderChanged" />
                                                <TextBlock Grid.Column="2" x:Name="ThresholdReadout" Style="{StaticResource ReadoutText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Pages: clean-up of the pages collected in the queue. -->
                                    <Expander x:Name="PagesSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Pages}">
                                        <StackPanel x:Name="PageOptions">
                                            <DockPanel x:Name="PagesReason" Margin="0,0,0,6" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.NeedsCollectPages}" />
                                            </DockPanel>
                                            <!-- Blank pages: flagged in the page strip, left out when saving. The
                                                 sensitivity segments (least first) are added in code. -->
                                            <CheckBox x:Name="SkipBlankBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Skip blank pages}" ToolTipService.ShowOnDisabled="True"
                                                      Checked="BlankPages_Changed" Unchecked="BlankPages_Changed" />
                                            <DockPanel x:Name="SkipBlankReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.BlankSheetsSplit}" />
                                            </DockPanel>
                                            <StackPanel x:Name="BlankSensitivityOptions" Margin="16,4,0,4">
                                                <TextBlock Text="{loc:T What counts as blank}" Style="{StaticResource FieldLabelText}" />
                                                <Border Style="{StaticResource SegmentedTrackStyle}"
                                                        AutomationProperties.Name="{loc:T What counts as blank}">
                                                    <UniformGrid x:Name="BlankSensitivitySegments" Rows="1" />
                                                </Border>
                                                <DockPanel x:Name="BlankHighNotice" Margin="0,4,0,0" Visibility="Collapsed">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static core:BlankSensitivities.HighWarning}" />
                                                </DockPanel>
                                            </StackPanel>
                                            <!-- Crop and straighten: changed pages carry a swap button in the page strip. -->
                                            <CheckBox x:Name="AutoCropBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Crop to page}" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{loc:T Cut away the scanner background}"
                                                      Checked="Geometry_Changed" Unchecked="Geometry_Changed" />
                                            <CheckBox x:Name="AutoStraightenBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Straighten pages}" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{loc:T Straighten slanted pages}"
                                                      Checked="Geometry_Changed" Unchecked="Geometry_Changed" />
                                            <!-- Turn pages upright by reading their text: a turned page carries an
                                                 undo button in the page strip. -->
                                            <CheckBox x:Name="AutoRotateBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Rotate pages upright}" ToolTipService.ShowOnDisabled="True"
                                                      Checked="AutoRotate_Changed" Unchecked="AutoRotate_Changed" />
                                            <DockPanel x:Name="AutoRotateReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="AutoRotateHint" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <!-- Books and magazines: each spread is cut at the spine into its two pages;
                                                 a page's Split… button or menu joins them again or moves the cut. -->
                                            <CheckBox x:Name="SplitFacingPagesBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Split facing pages}" ToolTipService.ShowOnDisabled="True"
                                                      Checked="SplitFacingPages_Changed" Unchecked="SplitFacingPages_Changed" />
                                            <DockPanel x:Name="SplitFacingPagesReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="SplitFacingPagesHint" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <StackPanel x:Name="BookOptions" Margin="16,4,0,0">
                                                <CheckBox x:Name="BookRightToLeftBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="{loc:T Reads right to left}"
                                                          ToolTip="{loc:T Arabic\, Hebrew\, manga: the right page of each spread comes first.}"
                                                          Checked="BookRightToLeft_Changed" Unchecked="BookRightToLeft_Changed" />
                                                <TextBlock Text="{loc:T Book rotation}" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
                                                <ComboBox x:Name="BookRotationBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{loc:T Book rotation}"
                                                          AutomationProperties.HelpText="{loc:T For a book lying sideways or upside down on the glass\, from the next spread on.}"
                                                          ToolTip="{loc:T For a book lying sideways or upside down on the glass}"
                                                          SelectionChanged="BookRotation_Changed" />
                                                <!-- The spine's shadow lightened on each page; the page strip's arrow shows a page as scanned. -->
                                                <CheckBox x:Name="SoftenSpineShadowBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                          Content="{loc:T Soften spine shadow}"
                                                          Checked="SoftenSpineShadow_Changed" Unchecked="SoftenSpineShadow_Changed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Split the stack into documents: the page strip shows where before saving,
                                         with a divider at each split; the gap between two pages splits or joins. -->
                                    <Expander x:Name="SplitSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Split into documents}">
                                        <StackPanel x:Name="SplitOptions">
                                            <DockPanel x:Name="SplitReason" Margin="0,0,0,6" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static local:ShortText.NeedsCollectPages}" />
                                            </DockPanel>
                                            <DockPanel Margin="{StaticResource LabelSpacing}">
                                                <local:InfoButton x:Name="SplitInfoButton" DockPanel.Dock="Right" Label="{loc:T Split into documents}"
                                                                  Heading="{loc:T How it works}" Margin="4,-4,0,-4" />
                                                <TextBlock Text="{loc:T Split|section}" Style="{StaticResource FieldLabelText}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ComboBox x:Name="SplitModeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{loc:T Split into documents}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="SplitMode_Changed" />
                                            <!-- One line: what happens to the sheets that split. -->
                                            <TextBlock x:Name="SplitHint" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <WrapPanel x:Name="SplitCountRow" Margin="0,8,0,0">
                                                <TextBlock Text="{loc:T Sheets per document}" Style="{StaticResource BodyText}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="SplitCountBox" Width="72"
                                                          AutomationProperties.Name="{loc:T Sheets per document}"
                                                          SelectionChanged="SplitCount_Changed" />
                                            </WrapPanel>
                                            <!-- At barcode or QR sheets: a page with a code kept as its document's first
                                                 page, or a separator sheet left out. -->
                                            <StackPanel x:Name="BarcodeOptions" Margin="0,8,0,0">
                                                <TextBlock Text="{loc:T Codes are on}" Style="{StaticResource FieldLabelText}" />
                                                <Border Style="{StaticResource SegmentedTrackStyle}" AutomationProperties.Name="{loc:T Codes are on}">
                                                    <UniformGrid Rows="1">
                                                        <RadioButton x:Name="CodesOnSeparatorsButton" Style="{StaticResource SegmentedTextItemStyle}"
                                                                     Content="{loc:T Separator sheets}" GroupName="CodesOn"
                                                                     AutomationProperties.Name="{loc:T Codes are on separator sheets}"
                                                                     Checked="CodesOn_Changed" />
                                                        <RadioButton x:Name="CodesOnFirstPagesButton" Style="{StaticResource SegmentedTextItemStyle}"
                                                                     Content="{loc:T First pages}" GroupName="CodesOn"
                                                                     AutomationProperties.Name="{loc:T Codes are on the documents\' first pages}"
                                                                     Checked="CodesOn_Changed" />
                                                    </UniformGrid>
                                                </Border>
                                                <TextBlock x:Name="BarcodeStartsDocumentHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,4" />
                                                <!-- The name the QR separator sheet carries; empty: a sheet that only splits. -->
                                                <StackPanel x:Name="QrSheetNameRow" Margin="0,4,0,0">
                                                    <TextBlock Text="{loc:T Name on sheet}" Style="{StaticResource FieldLabelText}" />
                                                    <Grid>
                                                        <TextBox x:Name="QrSheetNameBox"
                                                                 MaxLength="{x:Static core:DocumentSplitter.MaxLabelLength}"
                                                                 AutomationProperties.Name="{loc:T Name on the QR sheet}"
                                                                 ToolTip="{loc:T Names the document that follows the sheet}"
                                                                 TextChanged="QrSheetName_Changed" />
                                                        <TextBlock x:Name="QrSheetNamePlaceholder" Text="{loc:T Optional}" Style="{StaticResource PlaceholderText}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- The separator sheet: a PDF to print anywhere, or printed here. -->
                                            <WrapPanel Margin="-11,6,0,0">
                                                <Button x:Name="SaveSeparatorButton" Style="{StaticResource SubtleButtonStyle}"
                                                        local:Icon.Glyph="&#xE74E;" Content="{loc:T Save sheet}" Margin="0,0,4,0"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Click="SaveSeparator_Click" />
                                                <Button x:Name="PrintSeparatorButton" Style="{StaticResource SubtleButtonStyle}"
                                                        local:Icon.Glyph="&#xE749;" Content="{loc:T Print sheet}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Click="PrintSeparator_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Archive & password (PDFs): the two exclude each other; while one is on the
                                         other is greyed out with the reason next to it. -->
                                    <Expander x:Name="ArchiveSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T Archive &amp; password}">
                                        <StackPanel x:Name="PdfOnlyOptions">
                                            <!-- PDF/A-2b for keeping; label and hints from PdfA in Core. -->
                                            <CheckBox x:Name="ArchivalBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <DockPanel x:Name="ArchivalReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE72E;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static core:PdfA.NotWithPasswordReason}" />
                                            </DockPanel>
                                            <!-- The password is asked for at each save and never stored; label and
                                                 hints from PdfProtection in Core. -->
                                            <CheckBox x:Name="ProtectBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Margin="0,4,0,0" ToolTipService.ShowOnDisabled="True"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <DockPanel x:Name="ProtectReason" Margin="0,0,0,4" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE72E;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static core:PdfProtection.NotWithArchivalReason}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- More options: the text beside a PDF, after saving and the file name. -->
                                    <Expander x:Name="MoreSection" Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="{loc:T More options}">
                                        <StackPanel>
                                            <!-- The text of the pages in a .txt file beside each PDF; OCR reads each page once for both. -->
                                            <CheckBox x:Name="AlsoSaveTextBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="{loc:T Also save text (.txt)}" Margin="0,0,0,8"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{loc:T Saves the text in a .txt file next to the PDF}"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <DockPanel x:Name="AlsoSaveTextReason" Margin="0,-4,0,8" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE72E;" />
                                                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static core:PdfA.NotWithPasswordReason}" />
                                            </DockPanel>
                                            <StackPanel x:Name="AfterSaveRow">
                                                <TextBlock Text="{loc:T After saving}" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="AfterSaveBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{loc:T After saving}"
                                                          SelectionChanged="AfterSave_Changed" />
                                            </StackPanel>
                                            <TextBlock Text="{loc:T File name}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <DockPanel>
                                                <Button x:Name="InsertTokenButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}"
                                                        Content="{loc:T Insert}" Margin="4,0,0,0" Padding="8,5,8,6"
                                                        ToolTip="{loc:T Insert the date\, a number or another part}"
                                                        AutomationProperties.Name="{loc:T Insert into the file name}"
                                                        Click="InsertToken_Click" />
                                                <TextBox x:Name="TemplateBox" AutomationProperties.Name="{loc:T File name}"
                                                         TextChanged="TemplateBox_TextChanged"
                                                         LostFocus="Setting_Changed" />
                                            </DockPanel>
                                            <!-- Live state: the name the next file gets. -->
                                            <TextBlock x:Name="FileNamePreview" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Pinned actions: Scan is the primary action; Save with its menu below. -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,0,0" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreviewButton" Style="{StaticResource IconTextButtonStyle}"
                                                local:Icon.Glyph="&#xE8FF;" Content="{loc:T Preview}"
                                                HorizontalAlignment="Stretch" MinHeight="36"
                                                ToolTip="{loc:T Quick look at the whole glass}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AcceleratorKey="Ctrl+Shift+Enter"
                                                Click="Preview_Click" />
                                        <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                                local:Icon.Glyph="&#xE8FE;" Content="{loc:T Scan}" MinHeight="36"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AcceleratorKey="Ctrl+Enter"
                                                Click="Scan_Click" />
                                    </Grid>
                                    <!-- A name for the next save only; empty, the file name template names it. -->
                                    <Grid x:Name="SaveNameRow" Margin="0,8,0,0">
                                        <TextBox x:Name="SaveNameBox" MinHeight="32" MaxLength="100" Padding="6,5,28,5"
                                                 VerticalContentAlignment="Center"
                                                 ToolTipService.ShowOnDisabled="True"
                                                 AutomationProperties.Name="{loc:T Name for this save}"
                                                 TextChanged="SaveName_TextChanged"
                                                 PreviewKeyDown="SaveName_PreviewKeyDown" />
                                        <TextBlock x:Name="SaveNameHint" Style="{StaticResource CaptionText}" IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="8,0,30,0" TextTrimming="CharacterEllipsis"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <Button x:Name="ClearSaveNameButton" Style="{StaticResource SmallIconButtonStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Content="&#xE711;" Width="22" Height="22" FontSize="10" Visibility="Collapsed"
                                                AutomationProperties.Name="{loc:T Clear the name}"
                                                Click="ClearSaveName_Click" />
                                    </Grid>
                                    <!-- Save (with the page count and, for a protected PDF, a lock) and its menu;
                                         importing photos of documents; clearing the queue. -->
                                    <Grid x:Name="QueueButtons" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SavePdfButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                                ContentTemplate="{StaticResource SaveLabelTemplate}"
                                                local:Icon.Glyph="&#xEA90;" Content="{loc:T Save PDF}" MinHeight="36"
                                                AutomationProperties.AcceleratorKey="Ctrl+S"
                                                Click="SavePdf_Click" />
                                        <!-- The split part: the other ways to save the queue. -->
                                        <Button Grid.Column="2" x:Name="SaveMenuButton" Style="{StaticResource AccentButtonStyle}"
                                                FontFamily="{StaticResource IconFontFamily}" FontSize="10" Content="&#xE70D;"
                                                MinHeight="36" Width="30" Padding="0"
                                                ToolTip="{loc:T More ways to save}"
                                                AutomationProperties.Name="{loc:T More ways to save}"
                                                Click="SaveMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu x:Name="SaveMenu">
                                                    <!-- Add the pages to the end of a PDF the user picks (PdfAppender). -->
                                                    <MenuItem x:Name="AddToPdfButton" Click="AddToPdf_Click" ToolTipService.ShowOnDisabled="True">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8E5;" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <!-- The pages as a PDF in Lazy Print; the queue stays as it is. -->
                                                    <MenuItem x:Name="PrintQueueButton" Header="{loc:T Lazy Print}"
                                                              ToolTip="{loc:T Open it in Lazy Print\, then choose a printer and print}"
                                                              Click="PrintQueue_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE749;" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <!-- Pages from photos of documents, no scanner needed (PhotoImport). -->
                                        <Button Grid.Column="4" x:Name="ImportPhotosButton" Style="{StaticResource IconButtonStyle}"
                                                Content="&#xEB9F;" Width="36" Height="36"
                                                AutomationProperties.AcceleratorKey="Ctrl+O"
                                                Click="ImportPhotos_Click" />
                                        <Button Grid.Column="6" x:Name="ClearButton" Style="{StaticResource IconButtonStyle}"
                                                Content="&#xE74D;" Width="36" Height="36"
                                                ToolTip="{loc:T Remove all pages}"
                                                AutomationProperties.Name="{loc:T Remove every page from the queue}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="ClearPages_Click" />
                                    </Grid>
                                    <!-- Live state: Save adds the pages to a PDF picked on the start screen, with × to save a new one instead. -->
                                    <DockPanel x:Name="AppendTargetRow" Margin="0,4,0,0" Visibility="Collapsed">
                                        <Button DockPanel.Dock="Right" x:Name="ClearAppendTargetButton" Style="{StaticResource SmallIconButtonStyle}"
                                                Content="&#xE711;" Width="24" Height="24" FontSize="11"
                                                ToolTip="{loc:T Save a new PDF instead}"
                                                AutomationProperties.Name="{loc:T Save a new PDF instead of adding to this one}"
                                                Click="ClearAppendTarget_Click" />
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE8E5;" />
                                        <TextBlock x:Name="AppendTargetText" Style="{StaticResource ReasonText}" VerticalAlignment="Center"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{loc:T Scans}" x:Name="ScansTab" local:Icon.Glyph="&#xE81C;">
                    <local:ScanHistoryView x:Name="HistoryView" />
                </TabItem>

                <TabItem Header="{loc:T Saved|tab}" x:Name="SavedTab" local:Icon.Glyph="&#xE8B7;">
                    <local:SavedFilesView x:Name="SavedView" />
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Photo review dialog (leaves the status bar, with its Cancel button, reachable) -->
        <Grid Grid.Row="1" x:Name="PhotoReviewOverlay" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource DialogCardStyle}" MaxWidth="960" MaxHeight="680" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="24,16">
                        <DockPanel>
                            <!-- Receipts only: what to put in the scanner before Scan more. -->
                            <TextBlock x:Name="ReviewHint" DockPanel.Dock="Top" Style="{StaticResource SecondaryBodyText}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ReviewDiscardButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74D;" Content="{loc:T Discard}" MinWidth="120"
                                        Click="ReviewCancel_Click" />
                                <Button x:Name="ReviewScanMoreButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE8FE;" Content="{loc:T Scan more}" MinWidth="120" Margin="8,0,0,0"
                                        ToolTip="{loc:T Scan again and add the receipts to this review}"
                                        AutomationProperties.Name="{loc:T Scan more receipts}"
                                        AutomationProperties.HelpText="{loc:T Scans again and adds the receipts to this review}"
                                        AutomationProperties.AcceleratorKey="Ctrl+Enter"
                                        Visibility="Collapsed" Click="ReviewScanMore_Click" />
                                <Button x:Name="ReviewSaveButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74E;" Content="{loc:T Save Photos}" MinWidth="120"
                                        HorizontalAlignment="Right" Margin="8,0,0,0"
                                        Click="ReviewSave_Click" />
                            </StackPanel>
                            <!-- The same setting as the inspector's "After saving". -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="ReviewAfterSaveLabel" Text="{loc:T After saving}" Style="{StaticResource BodyText}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ReviewAfterSaveBox" MinWidth="140" MaxWidth="180"
                                          AutomationProperties.Name="{loc:T After saving}"
                                          SelectionChanged="AfterSave_Changed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="24,20,24,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock x:Name="ReviewTitle" Text="{loc:T Found photos}" Style="{StaticResource SubtitleText}" />
                            </StackPanel>
                            <!-- The right margin puts the scrollbar in the dialog's padding, clear of the cards. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="-6,0,-18,0">
                                <ItemsControl x:Name="PhotoGrid" Margin="0,0,12,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="208" Margin="6">
                                                <Border x:Name="Card" Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding CardName}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Well" Style="{StaticResource ImageWellStyle}" Height="160">
                                                            <Viewbox StretchDirection="DownOnly" Margin="5">
                                                                <Grid>
                                                                    <Image x:Name="SecondPiece" Source="{Binding SecondThumbnail}" MaxHeight="150" MaxWidth="190"
                                                                           FlowDirection="LeftToRight" Margin="6,6,0,0" Visibility="Collapsed"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.LayoutTransform>
                                                                            <RotateTransform Angle="{Binding SecondRotationDegrees}" />
                                                                        </Image.LayoutTransform>
                                                                    </Image>
                                                                    <Image x:Name="FirstPiece" Source="{Binding Thumbnail}" MaxHeight="150" MaxWidth="190" FlowDirection="LeftToRight"
                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                        <Image.LayoutTransform>
                                                                            <RotateTransform Angle="{Binding RotationDegrees}" />
                                                                        </Image.LayoutTransform>
                                                                    </Image>
                                                                </Grid>
                                                            </Viewbox>
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="{Binding PiecesCaption}"
                                                                   Margin="0,6,0,0" Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}" />
                                                        <DockPanel Grid.Row="3" Margin="0,8,0,0">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                                    Content="&#xE7AD;" ToolTip="{loc:T Rotate}"
                                                                    AutomationProperties.Name="{Binding RotateName}"
                                                                    Click="ReviewRotate_Click" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                                    Content="&#xE7A8;" ToolTip="{Binding CropTip}" IsEnabled="{Binding CropEnabled}"
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    AutomationProperties.Name="{Binding CropName}"
                                                                    Click="ReviewCrop_Click" />
                                                            <CheckBox Content="{loc:T Keep}" IsChecked="{Binding Included}" Click="ReviewKeep_Click"
                                                                      AutomationProperties.Name="{Binding KeepName}"
                                                                      VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <!-- After the Keep row in the file so Tab reaches it last; Grid.Row puts it above. -->
                                                        <DockPanel Grid.Row="2" Margin="0,8,0,0"
                                                                   Visibility="{Binding DatesShown, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasNoDate, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7BA;" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                                <TextBlock Style="{StaticResource CaptionText}" Text="{loc:T No date}" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </StackPanel>
                                                            <Grid Visibility="{Binding NotReading, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBox x:Name="DateBox" Height="28" MaxLength="10"
                                                                         Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Typography.NumeralAlignment="Tabular"
                                                                         AutomationProperties.Name="{loc:T Receipt date}"
                                                                         AutomationProperties.HelpText="{Binding NoDateHelp}"
                                                                         GotKeyboardFocus="ReviewDate_GotKeyboardFocus"
                                                                         ToolTip="{loc:T The date used in the file name. Leave it empty to use today\'s date.}"
                                                                         PreviewKeyDown="ReviewDate_PreviewKeyDown" />
                                                                <TextBlock Style="{StaticResource CaptionText}" Text="{loc:T yyyy-mm-dd}" IsHitTestVisible="False"
                                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                                           Visibility="{Binding DateHintShown, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Height="28"
                                                                        Visibility="{Binding IsReading, Converter={StaticResource BoolToVisibility}}">
                                                                <ProgressBar IsIndeterminate="True" Width="32" Height="3" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock Style="{StaticResource CaptionText}" Text="{loc:T Reading…}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <Button Grid.Row="4" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Stretch"
                                                                Content="{loc:T Join with previous}" ToolTip="{Binding JoinTip}"
                                                                ToolTipService.ShowOnDisabled="True"
                                                                IsEnabled="{Binding CanJoin}"
                                                                Visibility="{Binding JoinShown, Converter={StaticResource BoolToVisibility}}"
                                                                AutomationProperties.Name="{loc:T Join with previous receipt}"
                                                                AutomationProperties.HelpText="{loc:T Makes this and the previous receipt one receipt with two pieces}"
                                                                Click="ReviewJoin_Click" />
                                                        <Button Grid.Row="4" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Stretch"
                                                                Content="{loc:T Split apart}"
                                                                Visibility="{Binding SplitShown, Converter={StaticResource BoolToVisibility}}"
                                                                AutomationProperties.Name="{loc:T Split the joined receipt}"
                                                                Click="ReviewSplit_Click" />
                                                    </Grid>
                                                </Border>
                                                <Border x:Name="Ring" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="2"
                                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                        IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Included}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsJoined}" Value="True">
                                                    <Setter TargetName="SecondPiece" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="FirstPiece" Property="Margin" Value="0,0,6,6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Included}" Value="False">
                                                    <Setter TargetName="Well" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DateInvalid}" Value="True">
                                                    <Setter TargetName="DateBox" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter TargetName="DateBox" Property="ToolTip" Value="{loc:T Enter the date as year-month-day\, like 2026-11-03.}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ID card review: both sides, the page they go on, and saving. Modal like the photo
             review, leaving the status bar (with its Cancel button) reachable. -->
        <Grid Grid.Row="1" x:Name="IdCardReviewOverlay" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource DialogCardStyle}" MaxWidth="900" MaxHeight="720" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="24,16">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                                <Button x:Name="IdCardPrintButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE749;" Content="{loc:T Print}" MinWidth="110" Margin="0,0,8,0"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="IdCardPrint_Click" />
                                <Button x:Name="IdCardLazyPrintButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE749;" Content="{loc:T Lazy Print}" Margin="0,0,8,0"
                                        ToolTip="{loc:T Open it in Lazy Print\, then choose a printer and print}"
                                        Click="IdCardLazyPrint_Click" />
                                <Button x:Name="IdCardDiscardButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74D;" Content="{loc:T Discard}" MinWidth="110"
                                        Click="IdCardDiscard_Click" />
                                <Button x:Name="IdCardCloseButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE711;" Content="{loc:T Close}" MinWidth="110" Margin="8,0,0,0"
                                        ToolTip="{loc:T Keep the sides and close; Review in the settings column opens this again}"
                                        Click="IdCardClose_Click" />
                                <Button x:Name="IdCardSaveButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74E;" Content="{loc:T Save}" MinWidth="110" Margin="8,0,0,0"
                                        Click="IdCardSave_Click" />
                            </WrapPanel>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock x:Name="IdCardPaperLabel" Text="{loc:T Paper}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="IdCardPaperBox" MinWidth="150" AutomationProperties.Name="{loc:T Paper}"
                                              AutomationProperties.HelpText="{loc:T The page both sides are laid out on}"
                                              SelectionChanged="IdCardPaper_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock x:Name="IdCardFormatLabel" Text="{loc:T Save as}" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="IdCardFormatBox" MinWidth="90" AutomationProperties.Name="{loc:T Save as}"
                                              SelectionChanged="IdCardFormat_Changed" />
                                </StackPanel>
                                <CheckBox x:Name="IdCardSidesBox" Content="{loc:T Also save sides as images}"
                                          VerticalAlignment="Center" Margin="0,0,0,6"
                                          AutomationProperties.HelpText="{loc:T Each side is saved as a picture of its own too\, next to the page}"
                                          Click="IdCardSides_Click" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="24,20,24,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock x:Name="IdCardReviewTitle" Text="{loc:T Check the ID card}" Style="{StaticResource SubtitleText}" />
                                <!-- Privacy: always shown. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Background="Transparent"
                                            ToolTip="{x:Static core:IdCardSteps.PrivacyHelp}"
                                            AutomationProperties.HelpText="{x:Static core:IdCardSteps.PrivacyHelp}">
                                    <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xEA18;" Margin="0,1,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Static core:IdCardSteps.PrivacyNote}" Style="{StaticResource SecondaryBodyText}" />
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,-18,0">
                                <WrapPanel Margin="0,0,18,0">
                                    <!-- The sides: each with its turn, its crop and scanning it again. -->
                                    <StackPanel Width="300" Margin="0,0,24,12">
                                        <Border x:Name="IdCardFrontCard" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                                                AutomationProperties.Name="{loc:T Front side}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE72C;" Tag="front" ToolTip="{loc:T Scan again}"
                                                            AutomationProperties.Name="{loc:T Scan the front again}"
                                                            Click="IdCardRetake_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardFrontCropButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7A8;" Tag="front" ToolTip="{loc:T Fix crop}"
                                                            AutomationProperties.Name="{loc:T Fix the crop of the front}"
                                                            Click="IdCardCrop_Click" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7AD;" Tag="front" ToolTip="{loc:T Rotate}"
                                                            AutomationProperties.Name="{loc:T Turn the front 90° clockwise}"
                                                            Click="IdCardRotate_Click" />
                                                    <TextBlock Text="{loc:T Front}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Border Style="{StaticResource ImageWellStyle}" Height="170" Margin="0,8,0,0">
                                                    <Image x:Name="IdCardFrontImage" Margin="8" Stretch="Uniform" FlowDirection="LeftToRight"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.LayoutTransform>
                                                            <RotateTransform x:Name="IdCardFrontTurn" />
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Border>
                                                <DockPanel x:Name="IdCardFrontNotice" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="IdCardFrontNoteText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="IdCardBackCard" Style="{StaticResource CardStyle}" AutomationProperties.Name="{loc:T Back side}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackRetakeButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE72C;" Tag="back" ToolTip="{loc:T Scan again}"
                                                            AutomationProperties.Name="{loc:T Scan the back again}"
                                                            Click="IdCardRetake_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackCropButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7A8;" Tag="back" ToolTip="{loc:T Fix crop}"
                                                            AutomationProperties.Name="{loc:T Fix the crop of the back}"
                                                            Click="IdCardCrop_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackRotateButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7AD;" Tag="back" ToolTip="{loc:T Rotate}"
                                                            AutomationProperties.Name="{loc:T Turn the back 90° clockwise}"
                                                            Click="IdCardRotate_Click" />
                                                    <TextBlock Text="{loc:T Back}" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Border x:Name="IdCardBackWell" Style="{StaticResource ImageWellStyle}" Height="170" Margin="0,8,0,0">
                                                    <Image x:Name="IdCardBackImage" Margin="8" Stretch="Uniform" FlowDirection="LeftToRight"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.LayoutTransform>
                                                            <RotateTransform x:Name="IdCardBackTurn" />
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Border>
                                                <StackPanel x:Name="IdCardNoBack" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock Text="{loc:T No back side. Scan it if something is printed on the back.}"
                                                               Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" />
                                                    <Button x:Name="IdCardScanBackButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8FE;" Content="{loc:T Scan the back}" Tag="back"
                                                            HorizontalAlignment="Left" Margin="-11,4,0,0"
                                                            Click="IdCardRetake_Click" />
                                                </StackPanel>
                                                <DockPanel x:Name="IdCardBackNotice" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="IdCardBackNoteText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="IdCardSwapButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE8AB;" Content="{loc:T Swap sides}"
                                                AutomationProperties.Name="{loc:T Swap front and back}"
                                                HorizontalAlignment="Left" Margin="-11,8,0,0"
                                                ToolTip="{loc:T The sides were scanned the other way round}"
                                                Click="IdCardSwap_Click" />
                                    </StackPanel>
                                    <!-- The page both sides go on, drawn small. -->
                                    <StackPanel Width="300" Margin="0,0,0,12">
                                        <Border HorizontalAlignment="Left" Background="White" Effect="{DynamicResource PageShadow}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Image x:Name="IdCardPageImage" Height="380" Stretch="Uniform" FlowDirection="LeftToRight"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   AutomationProperties.Name="{loc:T Page preview}"
                                                   AutomationProperties.HelpText="{loc:T The page both sides are saved on}" />
                                        </Border>
                                        <TextBlock x:Name="IdCardLayoutText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                                        <DockPanel x:Name="IdCardSizeNotice" Visibility="Collapsed" Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                       Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <TextBlock x:Name="IdCardSizeText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Assertive" />
                                        </DockPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- While photo files the window takes are dragged over it: where they go. -->
        <Border Grid.Row="1" x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="8"
                CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Style="{StaticResource DialogCardStyle}" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphText}" FontSize="24" Text="&#xEB9F;" Margin="0,0,12,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Static core:PhotoImport.DropOverlay}" Style="{StaticResource SubtitleText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" MinHeight="36" Padding="8,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrintAgainButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE749;" Content="{loc:T Print again}" Padding="10,3,10,4" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            ToolTip="{loc:T Print the copy again on the same printer}"
                            AutomationProperties.HelpText="{loc:T Prints the copy again on the same printer}"
                            Click="PrintAgain_Click" />
                    <Button x:Name="ChooseAnotherPrinterButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE7F7;" Content="{loc:T Choose another printer}" Padding="10,3,10,4" Margin="0,0,12,0"
                            Visibility="Collapsed"
                            ToolTip="{loc:T Pick a printer for the copy}"
                            AutomationProperties.HelpText="{loc:T Opens the printer list in the copy options}"
                            Click="ChooseAnotherPrinter_Click" />
                    <Button x:Name="UndoButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE7A7;" Content="{loc:T Undo}" Padding="10,3,10,4" Margin="0,0,12,0"
                            Visibility="Collapsed" AutomationProperties.AcceleratorKey="Ctrl+Z"
                            Click="Undo_Click" />
                    <ProgressBar x:Name="BusyBar" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                                 AutomationProperties.Name="{loc:T Progress}" Visibility="Collapsed" />
                    <Button x:Name="ShowScannerButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE8A7;" Content="{loc:T Show the scanner\'s window}" Padding="10,3,10,4" Margin="0,0,12,0"
                            ToolTip="{loc:T Bring the scanner\'s window to the front}"
                            AutomationProperties.HelpText="{loc:T Bring the scanner\'s window to the front}"
                            Visibility="Collapsed" Click="ShowScanner_Click" />
                    <Button x:Name="CancelButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE711;" Content="{loc:T Cancel}" Padding="10,3,10,4"
                            Visibility="Collapsed" AutomationProperties.AcceleratorKey="Esc"
                            Click="Cancel_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <!-- A short line on screen; its name is the whole sentence, read out as it changes. -->
                <TextBlock x:Name="StatusText" Text="{loc:T Looking for scanners…}" Style="{StaticResource CaptionText}"
                           FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
