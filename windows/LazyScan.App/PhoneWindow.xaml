<Window x:Class="LazyScan.App.PhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LazyScan.App"
        xmlns:ui="clr-namespace:LazyScan.App"
        Title="{loc:T Phone}"
        Width="620" Height="760" MinWidth="460" MinHeight="420" ResizeMode="CanResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DetailLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,16,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Read-only and selectable, so the pairing text can be copied. -->
        <Style x:Key="DetailBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: start over on the left, close on the right. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{loc:T Close}" IsCancel="True" IsDefault="True"
                        MinWidth="96" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="{loc:T Reset pairing…}" ui:Icon.Glyph="&#xE72C;"
                        Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left"
                        ToolTip="{loc:T Unpair every phone and make a new security key for this PC}"
                        AutomationProperties.HelpText="{loc:T Unpairs every phone and makes a new security key; phones pair again with a new code}"
                        Click="Reset_Click" />
                <TextBlock x:Name="FooterStatus" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Margin="8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- Header: whether this PC receives from phones now. -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <TextBlock Text="{loc:T Send from your phone}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="{loc:T Documents scanned with Lazy Scan on a paired iPhone or iPad are added to the page queue here. Nothing goes through the internet: the phone and this PC talk directly\, encrypted\, on networks you trust.}" />
            <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="{loc:T Other phones cannot pair. Use Import photos of documents\, or a folder that the phone syncs to this PC.}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="24,0,24,16">
            <StackPanel>
                <!-- The networks this PC is on, and whether it receives there. -->
                <TextBlock Text="{loc:T Networks}" Style="{StaticResource SectionHeaderText}" Margin="0,4,0,8" />
                <StackPanel x:Name="NetworksPanel" AutomationProperties.Name="{loc:T Networks}" />

                <!-- Pairing: the QR code with its one-time code, the text to paste on the phone, and the question. -->
                <TextBlock Text="{loc:T Pair a phone}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" />
                <Border x:Name="PairCard" Style="{StaticResource CardStyle}" Padding="16,12,16,12">
                    <StackPanel>
                        <TextBlock x:Name="PairIntro" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   Text="{loc:T Open Lazy Scan on your iPhone or iPad\, go to Options › My computer\, and scan the code shown here. The code works once\, for 5 minutes.}" />
                        <Button x:Name="PairButton" Content="{loc:T Pair a phone}" ui:Icon.Glyph="&#xE8EA;" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Style="{StaticResource AccentIconTextButtonStyle}" Click="Pair_Click" />
                        <StackPanel x:Name="PairingPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="White" Padding="0" Margin="0,0,16,0"
                                        CornerRadius="4" VerticalAlignment="Top">
                                    <Image x:Name="QrImage" Stretch="None" FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="{loc:T Pairing code to scan with your phone}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="ExpiryText" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="{loc:T Cannot scan the code? Get this pairing text onto the phone (a message to yourself\, say) and paste it under Options › My computer › Enter pairing text\, then compare the check code.}" />
                                    <TextBlock x:Name="PairingTextLabel" Text="{loc:T Pairing text}" Style="{StaticResource DetailLabelText}" Margin="0,0,0,4" />
                                    <TextBox x:Name="PairingTextBox" Style="{StaticResource DetailBox}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=PairingTextLabel}" />
                                    <Button x:Name="CopyPairingTextButton" Content="{loc:T Copy}" ui:Icon.Glyph="&#xE8C8;" HorizontalAlignment="Left"
                                            Margin="0,0,0,6" Style="{StaticResource SubtleButtonStyle}"
                                            AutomationProperties.Name="{loc:T Copy the pairing text}" Click="CopyPairingText_Click" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CheckLabel" Text="{loc:T Check code}" Style="{StaticResource DetailLabelText}" Margin="0,6,16,6" />
                                        <TextBox Grid.Column="1" x:Name="CheckCodeBox" Style="{StaticResource DetailBox}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=CheckLabel}" />
                                    </Grid>
                                    <Button x:Name="StopPairingButton" Content="{loc:T Stop pairing}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Style="{StaticResource SubtleButtonStyle}" Click="StopPairing_Click" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <!-- A phone presented the code: the user allows it or not (shown until answered, though the code is used). -->
                        <Border x:Name="ApprovalCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,12,0,0"
                                Padding="16,12,16,12" BorderThickness="2"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock x:Name="ApprovalText" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AllowButton" Content="{loc:T Allow}" MinWidth="96"
                                            Style="{StaticResource AccentButtonStyle}" Click="Allow_Click" />
                                    <Button x:Name="DenyButton" Content="{loc:T Don\'t allow}" MinWidth="96" Margin="8,0,0,0" Click="Deny_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PairNote" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- The paired phones, each with Remove. -->
                <TextBlock Text="{loc:T Paired phones}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" />
                <StackPanel x:Name="PhonesPanel" AutomationProperties.Name="{loc:T Paired phones}" />

                <!-- The cloud folder phones put documents in when they cannot reach this PC (C2). -->
                <TextBlock x:Name="SyncFolderLabel" Text="{loc:T Cloud folder}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,8" />
                <Border Style="{StaticResource CardStyle}" Padding="16,12,16,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{loc:T A folder synced by OneDrive or iCloud Drive. The phone puts documents here when it cannot reach this PC; they are encrypted with a key only this PC and the phone know.}" />
                        <DockPanel>
                            <Button x:Name="ClearSyncFolderButton" DockPanel.Dock="Right" Content="{loc:T Clear}" Margin="4,0,0,0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTip="{loc:T Stop watching the cloud folder}" Click="ClearSyncFolder_Click" />
                            <Button x:Name="ChooseSyncFolderButton" DockPanel.Dock="Right" Content="{loc:T Choose…}" Margin="4,0,0,0"
                                    ToolTip="{loc:T Choose the cloud folder}" Click="ChooseSyncFolder_Click" />
                            <TextBox x:Name="SyncFolderBox" IsReadOnly="True"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SyncFolderLabel}" />
                        </DockPanel>
                        <TextBlock x:Name="SyncFolderStatus" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SyncFolderProblemText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Why a phone may not connect: the checks, one card each. -->
                <TextBlock Text="{loc:T Connection checks}" Style="{StaticResource SectionHeaderText}" Margin="0,16,0,4" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="ChecksPanel" AutomationProperties.Name="{loc:T Connection checks}"
                            KeyboardNavigation.TabNavigation="Continue" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
