<Project Sdk="Microsoft.NET.Sdk">

  <!-- The 64-bit TWAIN helper: the same program as LazyScan.TwainHelper (its sources are compiled in
       from that folder), built for x64 so the app can run 64-bit TWAIN drivers outside its own process.
       The app uses it only when LAZYSCAN_TWAIN_HELPER64=1 is set. It loads the 64-bit Data Source
       Manager (TWAINDSM.dll in System32), which is never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <RootNamespace>LazyScan.TwainHelper</RootNamespace>
    <AssemblyName>LazyScan.TwainHelper64</AssemblyName>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LazyScan.TwainHelper\Program.cs" Link="Program.cs" />
    <Compile Include="..\LazyScan.TwainHelper\SimulatedTwainHost.cs" Link="SimulatedTwainHost.cs" />
    <Compile Include="..\LazyScan.App\Scanning\Twain\NTwainDriver.cs" Link="Shared\NTwainDriver.cs" />
    <Compile Include="..\LazyScan.App\Scanning\Twain\NTwainSessionHost.cs" Link="Shared\NTwainSessionHost.cs" />
    <Compile Include="..\LazyScan.App\Scanning\Twain\NTwainHelperHost.cs" Link="Shared\NTwainHelperHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyScan.Core\LazyScan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NTwain" Version="[3.7.6]" />
  </ItemGroup>

</Project>
